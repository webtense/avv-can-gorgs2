generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model audit_log {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor      String?
  action     String
  item_type  String
  item_id    String?  @db.Uuid
  details    Json?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([item_type, item_id], map: "idx_audit_log_item")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model contributions {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contributor_name  String?
  contributor_email String?
  item_type         String
  payload           Json
  status            String    @default("pending")
  reviewed_by       String?
  reviewed_at       DateTime? @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)

  @@index([status], map: "idx_contributions_status")
}

model documents {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String
  description   String?
  file_path     String
  document_type String?
  document_year Int?
  event_id      String?  @db.Uuid
  source_id     String?  @db.Uuid
  rights_id     String?  @db.Uuid
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)
  events        events?  @relation(fields: [event_id], references: [id], onUpdate: NoAction)
  rights        rights?  @relation(fields: [rights_id], references: [id], onUpdate: NoAction)
  sources       sources? @relation(fields: [source_id], references: [id], onUpdate: NoAction)

  @@index([document_year], map: "idx_documents_document_year")
  @@index([event_id], map: "idx_documents_event_id")
  @@index([title(ops: raw("gin_trgm_ops"))], map: "idx_documents_title_trgm", type: Gin)
}

model events {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title              String
  description        String?
  event_date         DateTime?       @db.Date
  event_year         Int?
  festival_id        String?         @db.Uuid
  place_id           String?         @db.Uuid
  source_id          String?         @db.Uuid
  rights_id          String?         @db.Uuid
  members_only       Boolean         @default(false)
  reservations_open  Boolean         @default(false)
  capacity           Int?
  created_at         DateTime        @default(now()) @db.Timestamptz(6)
  updated_at         DateTime        @default(now()) @db.Timestamptz(6)
  documents          documents[]
  festivals          festivals?      @relation(fields: [festival_id], references: [id], onUpdate: NoAction)
  places             places?         @relation(fields: [place_id], references: [id], onUpdate: NoAction)
  rights             rights?         @relation(fields: [rights_id], references: [id], onUpdate: NoAction)
  sources            sources?        @relation(fields: [source_id], references: [id], onUpdate: NoAction)
  photos             photos[]
  videos             videos[]
  reservations       reservations[]
  event_photos       event_photos[]
  tpv_event_products tpv_event_products[]
  cash_sessions      cash_sessions[]
  tpv_stock_movements tpv_stock_movements[]

  @@index([event_year], map: "idx_events_event_year")
  @@index([festival_id], map: "idx_events_festival_id")
  @@index([place_id], map: "idx_events_place_id")
  @@index([title(ops: raw("gin_trgm_ops"))], map: "idx_events_title_trgm", type: Gin)
}

model members {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  email           String         @unique
  phone           String?
  password_hash   String
  status          String         @default("pendent")
  admin           Boolean        @default(false)
  gdpr_consent_at DateTime       @db.Timestamptz(6)
  mail_opt_out    Boolean        @default(false)
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  updated_at      DateTime       @default(now()) @db.Timestamptz(6)
  tpv_operator    Boolean        @default(false)
  reservations    reservations[]
  event_photos    event_photos[]
  cash_sessions_opened cash_sessions[] @relation("cash_sessions_opened_by")
  cash_sessions_closed cash_sessions[] @relation("cash_sessions_closed_by")
  tpv_sales            tpv_sales[]
  mail_log        mail_log[]

  @@index([status], map: "idx_members_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tpv_products {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  category       String?
  price_cents    Int?
  cost_cents     Int?
  active         Boolean         @default(false)
  sort           Int             @default(0)
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  updated_at     DateTime        @default(now()) @db.Timestamptz(6)
  tpv_sale_lines tpv_sale_lines[]
  tpv_event_products tpv_event_products[]
  tpv_stock_movements tpv_stock_movements[]
}

/// Productes del catàleg habilitats per a un acte de barra concret, amb preu propi opcional.
model tpv_event_products {
  event_id             String        @db.Uuid
  product_id           String        @db.Uuid
  price_cents_override Int?
  created_at           DateTime      @default(now()) @db.Timestamptz(6)
  event                events        @relation(fields: [event_id], references: [id], onDelete: Cascade)
  product              tpv_products  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@id([event_id, product_id])
  @@index([event_id], map: "idx_tpv_event_products_event_id")
}

model cash_sessions {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  opened_by           String     @db.Uuid
  opened_at           DateTime   @default(now()) @db.Timestamptz(6)
  opening_float_cents Int        @default(0)
  closed_at           DateTime?  @db.Timestamptz(6)
  closed_by           String?    @db.Uuid
  counted_cents       Int?
  expected_cents      Int?
  difference_cents    Int?
  note                String?
  event_id            String?    @db.Uuid
  event               events?    @relation(fields: [event_id], references: [id])
  opener              members    @relation("cash_sessions_opened_by", fields: [opened_by], references: [id])
  closer              members?   @relation("cash_sessions_closed_by", fields: [closed_by], references: [id])
  tpv_sales           tpv_sales[]
  tpv_stock_movements tpv_stock_movements[]

  @@index([opened_at], map: "idx_cash_sessions_opened_at")
  @@index([event_id], map: "idx_cash_sessions_event_id")
}

model tpv_sales {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id    String          @db.Uuid
  operator_id   String          @db.Uuid
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  total_cents   Int
  paid_cents    Int
  change_cents  Int
  voided        Boolean         @default(false)
  session       cash_sessions   @relation(fields: [session_id], references: [id])
  operator      members         @relation(fields: [operator_id], references: [id])
  lines         tpv_sale_lines[]

  @@index([session_id], map: "idx_tpv_sales_session_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tpv_sale_lines {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sale_id          String        @db.Uuid
  product_id       String?       @db.Uuid
  name             String
  unit_price_cents Int
  qty              Int
  line_total_cents Int
  is_free          Boolean       @default(false)
  gift_value_cents Int?
  sale             tpv_sales     @relation(fields: [sale_id], references: [id], onDelete: Cascade)
  product          tpv_products? @relation(fields: [product_id], references: [id], onDelete: SetNull)

  @@index([sale_id], map: "idx_tpv_sale_lines_sale_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// Moviments d'estoc per producte: entrades/sortides (manuals, admin), i
/// vendes/regals (generats automàticament en crear una línia de venda).
model tpv_stock_movements {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id         String         @db.Uuid
  event_id           String?        @db.Uuid
  session_id         String?        @db.Uuid
  type               String
  qty                Int
  unit_cost_cents    Int?
  unit_value_cents   Int?
  total_cost_cents   Int?
  total_value_cents  Int?
  note               String?
  created_at         DateTime       @default(now()) @db.Timestamptz(6)
  product            tpv_products   @relation(fields: [product_id], references: [id], onDelete: Cascade)
  event              events?        @relation(fields: [event_id], references: [id])
  session            cash_sessions? @relation(fields: [session_id], references: [id])

  @@index([product_id], map: "idx_tpv_stock_movements_product_id")
  @@index([event_id], map: "idx_tpv_stock_movements_event_id")
}

model mail_templates {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  locale     String     @default("ca")
  subject    String
  body_text  String
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  updated_at DateTime   @default(now()) @db.Timestamptz(6)
  mail_log   mail_log[]
}

model mail_log {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  member_id          String          @db.Uuid
  template_id        String?         @db.Uuid
  campaign_id        String?         @db.Uuid
  subject            String
  status             String
  provider_message_id String?
  error_code         String?
  created_at         DateTime        @default(now()) @db.Timestamptz(6)
  members            members         @relation(fields: [member_id], references: [id], onDelete: Cascade)
  mail_templates     mail_templates? @relation(fields: [template_id], references: [id], onDelete: SetNull)

  @@index([member_id], map: "idx_mail_log_member_id")
  @@index([status], map: "idx_mail_log_status")
  @@index([campaign_id], map: "idx_mail_log_campaign_id")
}

model reservations {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id   String    @db.Uuid
  member_id  String?   @db.Uuid
  name       String
  email      String
  quantity   Int
  status     String    @default("confirmada")
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  events     events    @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  members    members?  @relation(fields: [member_id], references: [id], onUpdate: NoAction)

  @@index([event_id], map: "idx_reservations_event_id")
  @@index([member_id], map: "idx_reservations_member_id")
}

model event_photos {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id    String?   @db.Uuid
  uploaded_by String    @db.Uuid
  file_name   String
  mime_type   String
  size_bytes  Int
  caption     String?
  approved    Boolean   @default(false)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  events      events?   @relation(fields: [event_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  members     members   @relation(fields: [uploaded_by], references: [id], onUpdate: NoAction)

  @@index([event_id], map: "idx_event_photos_event_id")
  @@index([approved], map: "idx_event_photos_approved")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model festivals {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  description   String?
  typical_month Int?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  events        events[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model item_tags {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tag_id     String   @db.Uuid
  item_type  String
  item_id    String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  tags       tags     @relation(fields: [tag_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tag_id, item_type, item_id])
  @@index([item_type, item_id], map: "idx_item_tags_item")
}

model people {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name    String
  birth_year   Int?
  death_year   Int?
  biography    String?
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  updated_at   DateTime       @default(now()) @db.Timestamptz(6)
  photo_people photo_people[]
}

model photo_people {
  photo_id  String @db.Uuid
  person_id String @db.Uuid
  people    people @relation(fields: [person_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  photos    photos @relation(fields: [photo_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([photo_id, person_id])
  @@index([person_id], map: "idx_photo_people_person_id")
}

model photos {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title          String
  description    String?
  file_path      String
  thumbnail_path String?
  taken_year     Int?
  event_id       String?        @db.Uuid
  place_id       String?        @db.Uuid
  source_id      String?        @db.Uuid
  rights_id      String?        @db.Uuid
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  updated_at     DateTime       @default(now()) @db.Timestamptz(6)
  photo_people   photo_people[]
  events         events?        @relation(fields: [event_id], references: [id], onUpdate: NoAction)
  places         places?        @relation(fields: [place_id], references: [id], onUpdate: NoAction)
  rights         rights?        @relation(fields: [rights_id], references: [id], onUpdate: NoAction)
  sources        sources?       @relation(fields: [source_id], references: [id], onUpdate: NoAction)

  @@index([event_id], map: "idx_photos_event_id")
  @@index([place_id], map: "idx_photos_place_id")
  @@index([taken_year], map: "idx_photos_taken_year")
  @@index([title(ops: raw("gin_trgm_ops"))], map: "idx_photos_title_trgm", type: Gin)
}

model places {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  latitude    Decimal? @db.Decimal(9, 6)
  longitude   Decimal? @db.Decimal(9, 6)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  events      events[]
  photos      photos[]
}

model rights {
  id                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                 String      @unique
  description          String
  is_public_domain     Boolean     @default(false)
  requires_attribution Boolean     @default(true)
  created_at           DateTime    @default(now()) @db.Timestamptz(6)
  documents            documents[]
  events               events[]
  photos               photos[]
  videos               videos[]
}

model sources {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  type         String
  contact_info String?
  notes        String?
  created_at   DateTime    @default(now()) @db.Timestamptz(6)
  updated_at   DateTime    @default(now()) @db.Timestamptz(6)
  documents    documents[]
  events       events[]
  photos       photos[]
  videos       videos[]
}

model tags {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String      @unique
  created_at DateTime    @default(now()) @db.Timestamptz(6)
  item_tags  item_tags[]
}

model videos {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String
  description      String?
  file_path        String
  duration_seconds Int?
  recorded_year    Int?
  event_id         String?  @db.Uuid
  source_id        String?  @db.Uuid
  rights_id        String?  @db.Uuid
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @default(now()) @db.Timestamptz(6)
  events           events?  @relation(fields: [event_id], references: [id], onUpdate: NoAction)
  rights           rights?  @relation(fields: [rights_id], references: [id], onUpdate: NoAction)
  sources          sources? @relation(fields: [source_id], references: [id], onUpdate: NoAction)

  @@index([event_id], map: "idx_videos_event_id")
  @@index([recorded_year], map: "idx_videos_recorded_year")
}
