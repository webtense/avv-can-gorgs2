DATABASE_URL="postgresql://pguser:password@localhost:5432/can_gorgs_ii"

# Clau secreta per signar les cookies de sessió dels socis (HMAC-SHA256).
# Obligatòria en producció: l'aplicació no arrenca sense aquesta variable.
# Genera-la, per exemple, amb: openssl rand -base64 48
SESSION_SECRET=""

# Directori on es desen les imatges pujades pels socis (opcional, per defecte /data/uploads)
UPLOAD_DIR="/data/uploads"
